doctype html
html(lang='en')
  include partials/head.pug
  body
    include partials/nav.pug
    main.container
      .card
        h1= category.name
        p= category.description
      h2 Posts in this category
      if posts.length
        .list-grid
          each post in posts
            article.card
              h3
                a(href=`/posts/${post.post_id}`)= post.title
              p.meta #{post.username} • #{new Date(post.created_at).toLocaleDateString()}
      else
        p No posts are in this category yet.
