//- app/views/categories.pug
extends layout

block content
  .page-head
    h1 Categories
    p.meta Browse posts by topic.

  .list-grid
    each c in categories
      article.card
        h2
          a(href=`/categories/${c.category_id}`)= c.name
        p.meta #{c.post_count} post#{c.post_count === 1 ? '' : 's'}
        if c.description
          p= c.description
