//- app/views/tag-detail.pug
extends layout

block content
  .page-head
    h1 Posts tagged ##{tag.name}

  if posts.length
    .list-grid
      each post in posts
        article.card.post-card
          .post-card-score
            span.score-number= post.score
            span.score-label score
          .post-card-body
            h3
              a(href=`/posts/${post.post_id}`)= post.title
            p.meta
              | by #{post.username}
              |  · #{post.category_name}
              |  · #{new Date(post.created_at).toLocaleDateString()}
            if post.is_spoiler
              p
                span.badge.badge-spoiler ⚠ Spoiler
  else
    .card.empty-state
      p No posts found for this tag.
