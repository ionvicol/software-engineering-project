doctype html
html(lang='en')
  include partials/head.pug
  body
    include partials/nav.pug
    main.container
      section.hero
        h1 Game Tips Forum
        p Share gaming advice, discover strategies, and browse community posts by category or tag.
      section.stats-grid
        .card
          h2 #{stats.users}
          p Users
        .card
          h2 #{stats.posts}
          p Posts
        .card
          h2 #{stats.categories}
          p Categories
        .card
          h2 #{stats.tags}
          p Tags
      section
        h2 Latest posts
        .list-grid
          each post in latestPosts
            article.card
              h3
                a(href=`/posts/${post.post_id}`)= post.title
              p.meta Posted by #{post.username} • #{post.category_name} • #{new Date(post.created_at).toLocaleDateString()}
      section
        h2 Top contributors
        .list-grid
          each user in topContributors
            article.card
              h3
                a(href=`/users/${user.user_id}`)= user.username
              p.meta Reputation: #{user.reputation_points} • Posts: #{user.post_count}
              p.rank-badge(class=`rank-${user.rank.toLowerCase()}`)= user.rank