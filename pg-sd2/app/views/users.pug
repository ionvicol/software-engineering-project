doctype html
html(lang='en')
  include partials/head.pug
  body
    include partials/nav.pug
    main.container
      h1 Community Members
      p Browse public gamer profiles and contribution totals.
      .list-grid
        each user in users
          article.card
            h2
              a(href=`/users/${user.user_id}`)= user.username
            p.meta Reputation: #{user.reputation_points}
            p.meta Posts created: #{user.post_count}
            p= user.bio
