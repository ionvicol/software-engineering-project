# Copy this file to `.env` and fill in any values you want to change for
# local development. docker-compose reads .env automatically.


# --- Database ---
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=sd2-db

# Hostname and port the web container uses to reach the db container.
DB_CONTAINER=db
DB_PORT=3306

# --- Sessions ---
# Used to sign session cookies. Change this to a long random string in
# any environment that is not a throwaway dev box.
SESSION_SECRET=dev-secret-change-me